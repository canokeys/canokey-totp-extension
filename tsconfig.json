{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "jsx": "react-jsx",
    "types": ["chrome", "vite/client", "node"]
  },
  "include": [".wxt/wxt.d.ts", ".wxt/imports.d.ts", "entrypoints", "lib", "tests", "browser-tests", "wxt.config.ts", "vitest.config.ts", "playwright.config.ts", "eslint.config.js"]
}
